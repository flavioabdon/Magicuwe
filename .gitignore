# ==========================================
# MagicUWE & MagicUWE Web - .gitignore
# ==========================================

# Dependencias y librerías
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# Variables de entorno y secretos
.env
.env*.local
.env.development
.env.test
.env.production
*.env
!.env.example
!**/.env.example

# Bases de datos y archivos de persistencia local
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-wal
*.sqlite-shm
**/data/*.sqlite
**/data/*.sqlite3
**/data/magicuwe_fallback.json

# Vercel y builds
.vercel/
.output/
dist/
build/
.cache/

# Logs y temporales
logs/
*.log
*.tmp
*.temp
.tmp/
tmp/

# Archivos del sistema operativo (macOS / Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs y editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Java / MagicDraw temporales
*.class
hs_err_pid*
